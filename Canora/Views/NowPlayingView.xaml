<?xml version="1.0" encoding="utf-8" ?>
<!-- Figma "Music Player Screen" (15:19). Il gradiente di sfondo parte dal colore dominante della copertina.
     Omessi: Cast (non supportato) e la card Lyrics (YouTube non dà i testi). -->
<ContentView x:Class="Canora.Views.NowPlayingView"
			 x:DataType="PlayerViewModel"
			 Background="{Binding AccentBackground}">
	<!-- La seconda colonna (Auto) ha contenuto solo in landscape: Testo, pulsanti e Condividi in colonna (vedi code-behind) -->
	<Grid x:Name="Root" RowDefinitions="Auto,*,Auto,Auto,Auto" ColumnDefinitions="*,Auto" Padding="20,10,20,28">

		<!-- Copertina come l'hero delle pagine artista/podcast: da bordo a bordo (annulla il Padding) e alta quanto tutto
		     lo spazio sopra la barra di avanzamento, con la barra in alto sopra. Titolo e autore in basso.
		     Al posto del cuore del Figma: "+" per aggiungere a una playlist, col colore del testo dell'hero. -->
		<Hero x:Name="PlayerHero" SafeAreaEdges="None" Grid.RowSpan="2" Margin="-20,-10,-20,0" HeightRequest="-1" TitleMargin="20,0,64,18"
			  Source="{Binding Current.ArtworkUrl}" Title="{Binding Current.Title}" Subtitle="{Binding Current.Artist}" SubtitleTapped="OnArtistTapped">
			<Grid x:Name="AddButton" WidthRequest="48" HeightRequest="48" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,10,12" IsVisible="{Binding CanAddToPlaylist}" SemanticProperties.Description="Aggiungi a playlist">
				<Image Source="ic_add.png" WidthRequest="28" HeightRequest="28" Tint.Color="{Binding TextColor, Source={x:Reference PlayerHero}}" />
				<Grid.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding AddToPlaylistCommand}" />
				</Grid.GestureRecognizers>
			</Grid>
			<Hero.GestureRecognizers>
				<PanGestureRecognizer PanUpdated="OnPanUpdated" />
			</Hero.GestureRecognizers>
		</Hero>

		<!-- Top info sopra la copertina: chevron, "PLAYING FROM SEARCH" / "“stay” in Songs", ⋮ col colore di TopColor -->
		<Grid x:Name="TopBar" ColumnDefinitions="44,*,44" MinimumHeightRequest="44">
			<Grid SemanticProperties.Description="Chiudi">
				<Image Source="ic_chevron_down.png" WidthRequest="20" HeightRequest="20" Rotation="90" Tint.Color="{Binding TopColor, Source={x:Reference PlayerHero}}" HorizontalOptions="Start" VerticalOptions="Start" Margin="0,10,0,0" />
				<Grid.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnCloseTapped" />
				</Grid.GestureRecognizers>
			</Grid>
			<VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
				<Label Text="{Binding QueueHeader}" TextColor="{Binding TopColor, Source={x:Reference PlayerHero}}" FontFamily="PoppinsMedium" FontSize="14" HorizontalTextAlignment="Center" />
				<Label Text="{Binding QueueTitle}" TextColor="{Binding TopColor, Source={x:Reference PlayerHero}}" FontFamily="PoppinsSemiBold" FontSize="16" CharacterSpacing="-0.32" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
			</VerticalStackLayout>
			<Grid Grid.Column="2" SemanticProperties.Description="Altre opzioni">
				<Image Source="ic_dots.png" WidthRequest="10" HeightRequest="24" Tint.Color="{Binding TopColor, Source={x:Reference PlayerHero}}" HorizontalOptions="End" VerticalOptions="Start" Margin="0,10,0,0" />
				<Grid.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding TrackMenuCommand}" CommandParameter="{Binding Current}" />
				</Grid.GestureRecognizers>
			</Grid>
			<Grid.GestureRecognizers>
				<PanGestureRecognizer PanUpdated="OnPanUpdated" />
			</Grid.GestureRecognizers>
		</Grid>

		<!-- Karaoke come Spotify: il testo prende il posto di copertina e barra in alto, sul colore del brano. La riga
		     cantata è piena, quelle già cantate a metà, le prossime appena accennate; la lista segue la riga in corso
		     (vedi code-behind) e un tocco su una riga porta lì il brano. Seek bar e controlli restano sotto. -->
		<Grid x:Name="Karaoke" Grid.RowSpan="2" Margin="-20,-10,-20,0" RowDefinitions="Auto,*" BackgroundColor="{Binding LyricsColor}" IsVisible="{Binding IsLyricsOpen}">
			<Grid ColumnDefinitions="44,*,40" Padding="20,10,20,12">
				<Grid SemanticProperties.Description="Chiudi il testo">
					<Image Source="ic_chevron_down.png" WidthRequest="20" HeightRequest="20" Rotation="90" Style="{StaticResource Icon}" HorizontalOptions="Start" VerticalOptions="Start" Margin="0,10,0,0" />
					<Grid.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding ToggleLyricsCommand}" />
					</Grid.GestureRecognizers>
				</Grid>
				<!-- Lucchetto, dal lato opposto del chevron: aperto (e colorato) = lo schermo resta acceso finché si canta -->
				<Grid Grid.Column="2" SemanticProperties.Description="Tieni acceso lo schermo">
					<Image Source="ic_lock.png" WidthRequest="20" HeightRequest="20" Style="{StaticResource Icon}" HorizontalOptions="End" VerticalOptions="Start" Margin="0,10,0,0">
						<Image.Triggers>
							<DataTrigger TargetType="Image" Binding="{Binding IsScreenAwake}" Value="True">
								<Setter Property="Source" Value="ic_lock_open.png" />
								<Setter Property="Tint.Color" Value="{DynamicResource Accent}" />
							</DataTrigger>
						</Image.Triggers>
					</Image>
					<Grid.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding ToggleScreenAwakeCommand}" />
					</Grid.GestureRecognizers>
				</Grid>
				<VerticalStackLayout Grid.Column="1" Margin="0,4,0,0">
					<Label Text="{Binding Current.Title}" FontFamily="MontserratBold" FontSize="16" TextColor="{DynamicResource TextPrimary}" LineBreakMode="TailTruncation" />
					<Label x:Name="KaraokeArtistLabel" Text="{Binding Current.Artist}" FontFamily="MontserratMedium" FontSize="14" TextColor="{DynamicResource TextPrimary}" Opacity="0.7" LineBreakMode="TailTruncation" HorizontalOptions="Start" BackgroundColor="Transparent">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnArtistTapped" />
						</Label.GestureRecognizers>
					</Label>
				</VerticalStackLayout>
			</Grid>
			<CollectionView x:Name="LyricsList" Grid.Row="1" ItemsSource="{Binding Lyrics.Lines}" SelectionMode="None" VerticalScrollBarVisibility="Never" Margin="20,0">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
				</CollectionView.ItemsLayout>
				<CollectionView.EmptyView>
					<Label Text="{Binding LyricsMessage}" FontFamily="MontserratBold" FontSize="18" TextColor="{DynamicResource TextPrimary}" Opacity="0.7" HorizontalTextAlignment="Center" VerticalOptions="Center" />
				</CollectionView.EmptyView>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="LyricLine">
						<Label Text="{Binding Text}" FontFamily="MontserratBold" FontSize="24" CharacterSpacing="-0.5" TextColor="{DynamicResource TextPrimary}" Opacity="0.35">
							<Label.Triggers>
								<DataTrigger TargetType="Label" Binding="{Binding IsSung}" Value="True">
									<Setter Property="Opacity" Value="0.7" />
								</DataTrigger>
								<DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
									<Setter Property="Opacity" Value="1" />
								</DataTrigger>
							</Label.Triggers>
							<Label.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding SeekToLyricCommand, Source={RelativeSource AncestorType={x:Type PlayerViewModel}}}" CommandParameter="{Binding .}" />
							</Label.GestureRecognizers>
						</Label>
					</DataTemplate>
				</CollectionView.ItemTemplate>
				<!-- Spazio sotto l'ultima riga: anche le ultime arrivano al centro -->
				<CollectionView.Footer>
					<BoxView HeightRequest="200" Color="Transparent" />
				</CollectionView.Footer>
			</CollectionView>
		</Grid>

		<!-- Landscape (e sempre su Windows): copertina e karaoke prendono tutto lo spazio e i controlli ci stanno sopra;
		     queste velature scure a destra (colonna dei pulsanti) e in basso (barra) li tengono leggibili anche su una
		     copertina chiara. Su Windows solo quella in basso, alta quanto i controlli (vedi il costruttore). -->
		<Grid x:Name="LandscapeShade" SafeAreaEdges="None" Grid.RowSpan="5" Grid.ColumnSpan="2" Margin="-20,-10,-20,-12" IsVisible="False" InputTransparent="True">
			<BoxView x:Name="SideShade" WidthRequest="160" HorizontalOptions="End">
				<BoxView.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Color="#00000000" Offset="0" />
						<GradientStop Color="#B3000000" Offset="1" />
					</LinearGradientBrush>
				</BoxView.Background>
			</BoxView>
			<!-- In basso più alta e più scura: barra e tempi (bianchi) devono leggersi anche su una copertina bianca,
			     mentre all'altezza del titolo resta quasi trasparente. -->
			<BoxView x:Name="BottomShade" HeightRequest="160" VerticalOptions="End">
				<BoxView.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Color="#00000000" Offset="0" />
						<GradientStop Color="#80000000" Offset="0.4" />
						<GradientStop Color="#D9000000" Offset="1" />
					</LinearGradientBrush>
				</BoxView.Background>
			</BoxView>
		</Grid>

		<!-- Range: traccia 4px #3D3C38, avanzamento bianco, pallino 10px. Lo Slider sopra, quasi trasparente,
		     gestisce solo il trascinamento: lo Slider Material 3 di MAUI 11 non ha questo aspetto. -->
		<Grid x:Name="SeekBar" Grid.Row="2" Grid.ColumnSpan="2" Margin="17,32,15,0" HeightRequest="10">
			<AbsoluteLayout>
				<BoxView x:Name="Rail" AbsoluteLayout.LayoutBounds="0,0.5,1,4" AbsoluteLayout.LayoutFlags="WidthProportional,YProportional" Color="{DynamicResource SeekRail}" CornerRadius="2" />
				<BoxView AbsoluteLayout.LayoutBounds="{Binding ProgressBounds}" AbsoluteLayout.LayoutFlags="WidthProportional,YProportional" HeightRequest="4" Color="{DynamicResource TextPrimary}" CornerRadius="2" />
				<Ellipse AbsoluteLayout.LayoutBounds="{Binding ThumbBounds}" AbsoluteLayout.LayoutFlags="XProportional,YProportional" WidthRequest="10" HeightRequest="10" Fill="{DynamicResource TextPrimary}" />
			</AbsoluteLayout>
			<Slider Minimum="0"
					Maximum="{Binding SliderMaximum}"
					Value="{Binding Position}"
					DragStartedCommand="{Binding SeekStartedCommand}"
					DragCompletedCommand="{Binding SeekCompletedCommand}"
					Opacity="0.01"
					Margin="-14,-16"
					SemanticProperties.Description="Posizione nel brano" />
		</Grid>

		<!-- Time Limit -->
		<Grid x:Name="Times" Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,*" Margin="17,8,15,0">
			<Label Text="{Binding PositionText}" Style="{StaticResource PlayerTime}" />
			<Label Grid.Column="1" Text="{Binding DurationText}" Style="{StaticResource PlayerTime}" HorizontalTextAlignment="End" />
		</Grid>

		<!-- Controlli: modalità 30, prev 24×28, play/pause 76, next 24×28. Un FlexLayout: in riga (portrait)
		     o in colonna a destra della copertina (landscape); le coppie episodio/brano condividono il posto perché
		     il FlexLayout salta gli elementi nascosti.
		     Episodi: −15 s e +15 s al posto di shuffle e loop (la coda di un podcast è quasi sempre un episodio solo). -->
		<!-- Su Windows la fila è larga 360 e centrata (sulla larghezza del desktop i pulsanti finirebbero ai due bordi) e i
		     pulsanti sono al 75%: vedi il costruttore. -->
		<FlexLayout x:Name="Buttons" Grid.Row="4" Grid.ColumnSpan="2" JustifyContent="SpaceBetween" AlignItems="Center" HeightRequest="76" Margin="15,0,15,0"
					WidthRequest="{OnIdiom Default=-1, Desktop=360}" HorizontalOptions="{OnIdiom Default=Fill, Desktop=Center}">
			<Image Source="ic_replay15.png" WidthRequest="30" HeightRequest="30" Style="{StaticResource Icon}" IsVisible="{Binding IsEpisode}" SemanticProperties.Description="Indietro di 15 secondi">
				<Image.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding SkipBackCommand}" />
				</Image.GestureRecognizers>
			</Image>
			<!-- Modalità: normale → ripeti → casuale (brani; gli episodi hanno −15 s qui) -->
			<Grid WidthRequest="30" HeightRequest="30" SemanticProperties.Description="Modalità di riproduzione: normale, ripeti, casuale">
				<Grid.Triggers>
					<DataTrigger TargetType="Grid" Binding="{Binding IsEpisode}" Value="True">
						<Setter Property="IsVisible" Value="False" />
					</DataTrigger>
				</Grid.Triggers>
				<Image Source="{Binding PlayModeIcon}" Style="{StaticResource Icon}">
					<Image.Triggers>
						<DataTrigger TargetType="Image" Binding="{Binding IsPlayModeOn}" Value="True">
							<Setter Property="Tint.Color" Value="{DynamicResource Accent}" />
						</DataTrigger>
					</Image.Triggers>
				</Image>
				<!-- Ripeti brano (da un controller esterno): il "1" di Spotify -->
				<Label Text="1" IsVisible="{Binding IsRepeatOne}" FontFamily="MontserratBold" FontSize="9" TextColor="{DynamicResource Accent}" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-6,-6,0" />
				<Grid.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding CyclePlayModeCommand}" />
				</Grid.GestureRecognizers>
			</Grid>
			<Image Source="ic_next.png" WidthRequest="24" HeightRequest="28" ScaleX="-1" Style="{StaticResource Icon}" SemanticProperties.Description="Precedente">
				<Image.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding PreviousCommand}" />
				</Image.GestureRecognizers>
			</Image>
			<Grid x:Name="PlayButton" WidthRequest="76" HeightRequest="76" SemanticProperties.Description="Riproduci o metti in pausa">
				<Image Source="ic_play_circle.png" Style="{StaticResource Icon}">
					<Image.Triggers>
						<DataTrigger TargetType="Image" Binding="{Binding IsPlaying}" Value="True">
							<Setter Property="Source" Value="ic_pause_circle.png" />
						</DataTrigger>
					</Image.Triggers>
				</Image>
				<!-- Durante il caricamento: cerchio pieno con lo spinner al posto del glifo -->
				<Ellipse Fill="{DynamicResource TextPrimary}" IsVisible="{Binding IsLoading}" />
				<ActivityIndicator Color="{DynamicResource Background}" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" WidthRequest="32" HeightRequest="32" />
				<Grid.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding TogglePlayCommand}" />
				</Grid.GestureRecognizers>
			</Grid>
			<Image Source="ic_next.png" WidthRequest="24" HeightRequest="28" Style="{StaticResource Icon}" SemanticProperties.Description="Successivo">
				<Image.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding NextCommand}" />
				</Image.GestureRecognizers>
			</Image>
			<Image Source="ic_forward15.png" WidthRequest="30" HeightRequest="30" Style="{StaticResource Icon}" IsVisible="{Binding IsEpisode}" SemanticProperties.Description="Avanti di 15 secondi">
				<Image.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding SkipForwardCommand}" />
				</Image.GestureRecognizers>
			</Image>
			<!-- Karaoke: microfono da cantante dove gli episodi hanno +15 s, colorato col testo aperto (solo se LRCLIB l'ha
			     trovato). Senza testo resta invisibile ma tiene il posto, così il play resta al centro. -->
			<Grid WidthRequest="30" HeightRequest="30" SemanticProperties.Description="Testo del brano">
				<Grid.Triggers>
					<DataTrigger TargetType="Grid" Binding="{Binding IsEpisode}" Value="True">
						<Setter Property="IsVisible" Value="False" />
					</DataTrigger>
					<DataTrigger TargetType="Grid" Binding="{Binding HasLyrics}" Value="False">
						<Setter Property="Opacity" Value="0" />
						<Setter Property="InputTransparent" Value="True" />
					</DataTrigger>
				</Grid.Triggers>
				<Image Source="ic_mic.png" Style="{StaticResource Icon}">
					<Image.Triggers>
						<DataTrigger TargetType="Image" Binding="{Binding IsLyricsOpen}" Value="True">
							<Setter Property="Tint.Color" Value="{DynamicResource Accent}" />
						</DataTrigger>
					</Image.Triggers>
				</Image>
				<Grid.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding ToggleLyricsCommand}" />
				</Grid.GestureRecognizers>
			</Grid>
		</FlexLayout>

		<!-- Windows: titolo e artista a sinistra nella riga dei controlli, come sui player desktop, quando fra il bordo e i
		     pulsanti c'è posto (vedi UpdateRowTitle); se no restano sulla copertina. Il "+" li segue, come su Spotify. -->
		<Grid x:Name="RowTitle" Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto" ColumnSpacing="12" IsVisible="False" HorizontalOptions="Start" VerticalOptions="Center" Margin="15,0,0,0">
			<VerticalStackLayout VerticalOptions="Center" Spacing="2">
				<Label x:Name="RowTitleLabel" Text="{Binding Current.Title}" FontFamily="MontserratBold" FontSize="18" TextColor="{DynamicResource TextPrimary}" LineBreakMode="TailTruncation" />
				<Label x:Name="RowArtistLabel" Text="{Binding Current.Artist}" FontFamily="MontserratMedium" FontSize="14" TextColor="{DynamicResource TextPrimary}" Opacity="0.7" LineBreakMode="TailTruncation" BackgroundColor="Transparent">
					<Label.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnArtistTapped" />
					</Label.GestureRecognizers>
				</Label>
			</VerticalStackLayout>
			<Grid Grid.Column="1" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" IsVisible="{Binding CanAddToPlaylist}" SemanticProperties.Description="Aggiungi a playlist">
				<Image Source="ic_add.png" WidthRequest="24" HeightRequest="24" Style="{StaticResource Icon}" />
				<Grid.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding AddToPlaylistCommand}" />
				</Grid.GestureRecognizers>
			</Grid>
		</Grid>

		<!-- Windows: volume dell'app a destra dei controlli, come sui player desktop. Resta fra un avvio e l'altro
		     (PlayerViewModel.Volume); su Android si usano i tasti del volume del telefono. -->
		<HorizontalStackLayout x:Name="VolumeBar" Grid.Row="4" Grid.ColumnSpan="2" IsVisible="{OnIdiom Default=False, Desktop=True}" HorizontalOptions="End" VerticalOptions="Center" Spacing="8" Margin="0,0,15,0">
			<Label Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
			<Slider x:Name="VolumeSlider" Value="{Binding Volume}" Minimum="0" Maximum="1" WidthRequest="140" VerticalOptions="Center"
					MinimumTrackColor="{DynamicResource TextPrimary}" MaximumTrackColor="{DynamicResource SeekRail}" ThumbColor="{DynamicResource TextPrimary}"
					SemanticProperties.Description="Volume" />
		</HorizontalStackLayout>
	</Grid>
</ContentView>
