<?xml version="1.0" encoding="utf-8" ?>
<!-- "Songs Section" della Playlist Screen: copertina, titolo, album, badge + artista, menu ⋮. Il badge "LYRICS" del
     design qui mostra la durata (i testi non ci sono). Sul telefono tre righe (titolo, album, durata e artista), così
     l'album non si taglia; su Windows due, con "Album · Artista" sulla seconda (vedi code-behind).
     In riproduzione: titolo nell'accento e le barre dell'equalizzatore sulla copertina. -->
<ContentView x:Class="Canora.Controls.TrackRow"
			 x:Name="Root"
			 x:DataType="Track">
	<Grid x:Name="RowGrid" ColumnDefinitions="61,*,36" ColumnSpacing="8" HeightRequest="65">
		<Grid x:Name="Cover" WidthRequest="61" HeightRequest="61" VerticalOptions="Center">
			<Image Source="{Binding ThumbUrl}" Aspect="AspectFill" />
			<NowPlayingBadge x:Name="Playing" IsVisible="False" />
		</Grid>
		<VerticalStackLayout x:Name="Texts" Grid.Column="1" VerticalOptions="Center" Spacing="6">
			<Label x:Name="TitleLabel" Text="{Binding Title}" Style="{StaticResource RowTitle}" />
			<!-- Telefono: l'album su una riga sua (tolto su Windows) -->
			<Label x:Name="MobileAlbumLabel" Text="{Binding Album}" IsVisible="{Binding HasAlbum}" Style="{StaticResource RowArtist}" MaxLines="1" HorizontalOptions="Start" BackgroundColor="Transparent">
				<Label.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnAlbumTapped" />
				</Label.GestureRecognizers>
			</Label>
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
				<Border BackgroundColor="{DynamicResource Badge}" StrokeThickness="0" StrokeShape="RoundRectangle 2" Padding="3,1" VerticalOptions="Center">
					<Label Text="{Binding DurationText}" Style="{StaticResource BadgeText}" />
				</Border>
				<!-- Album (solo Windows: sul telefono ha la riga sopra) · Artista: ognuno apre la sua scheda, il resto della
				     riga fa partire il brano. Le larghezze le decide FitLine. -->
				<Grid x:Name="Line" Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto" SizeChanged="OnLineSizeChanged">
					<Label x:Name="AlbumLabel" Text="{Binding Album}" IsVisible="{Binding HasAlbum}" Style="{StaticResource RowArtist}" MaxLines="1" BackgroundColor="Transparent">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnAlbumTapped" />
						</Label.GestureRecognizers>
					</Label>
					<Label x:Name="DotLabel" Grid.Column="1" Text="&#xA0;·&#xA0;" IsVisible="{Binding HasAlbum}" Style="{StaticResource RowArtist}" />
					<Label x:Name="ArtistLabel" Grid.Column="2" Text="{Binding Artist}" Style="{StaticResource RowArtist}" MaxLines="1" BackgroundColor="Transparent">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnArtistTapped" />
						</Label.GestureRecognizers>
					</Label>
				</Grid>
			</Grid>
		</VerticalStackLayout>
		<Grid Grid.Column="2" SemanticProperties.Description="Altre opzioni">
			<Image Source="ic_dots_row.png" WidthRequest="10" HeightRequest="25" HorizontalOptions="End" Style="{StaticResource Icon}" />
			<Grid.GestureRecognizers>
				<TapGestureRecognizer Command="{Binding MenuCommand, Source={x:Reference Root}}" CommandParameter="{Binding .}" />
			</Grid.GestureRecognizers>
		</Grid>
	</Grid>
</ContentView>
