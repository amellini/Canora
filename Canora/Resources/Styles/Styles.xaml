<?xml version="1.0" encoding="UTF-8" ?>
<!-- Tipografia del Figma. Gotham (proprietario) → Montserrat; Poppins come nel design.
     CharacterSpacing di MAUI su Android è in 1/16 di em: tracking Figma (px) / fontSize × 16. -->
<ResourceDictionary>

	<Style TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratRegular" />
		<Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
	</Style>

	<Style TargetType="ActivityIndicator">
		<Setter Property="Color" Value="{DynamicResource TextPrimary}" />
	</Style>

	<!-- "Search" 42 / -3.36 -->
	<Style x:Key="ScreenTitle" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratBold" />
		<Setter Property="FontSize" Value="42" />
		<Setter Property="CharacterSpacing" Value="-1.28" />
	</Style>

	<!-- "Made for you", "Trending now" 28 / -1.4 -->
	<Style x:Key="SectionTitle" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratBold" />
		<Setter Property="FontSize" Value="28" />
		<Setter Property="CharacterSpacing" Value="-0.8" />
	</Style>

	<!-- "Your top genres", "Browse all" 20 / -1.2 -->
	<Style x:Key="SubsectionTitle" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratBold" />
		<Setter Property="FontSize" Value="20" />
		<Setter Property="CharacterSpacing" Value="-0.96" />
	</Style>

	<!-- Caption delle collezioni in Home: Poppins Medium 14 -->
	<Style x:Key="Caption" TargetType="Label">
		<Setter Property="FontFamily" Value="PoppinsMedium" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
	</Style>

	<!-- Playlist Screen: descrizione e "likes . durata", Poppins Medium 15 / -0.45 -->
	<Style x:Key="Description" TargetType="Label">
		<Setter Property="FontFamily" Value="PoppinsMedium" />
		<Setter Property="FontSize" Value="15" />
		<Setter Property="CharacterSpacing" Value="-0.48" />
		<Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
	</Style>

	<!-- Titolo card brano: Gotham Bold 18 -->
	<Style x:Key="CardTitle" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratBold" />
		<Setter Property="FontSize" Value="18" />
		<Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
		<Setter Property="LineBreakMode" Value="TailTruncation" />
	</Style>

	<!-- "Song . Imagine Dragons": Gotham Bold 14 -->
	<Style x:Key="CardSubtitle" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratBold" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
		<Setter Property="LineBreakMode" Value="TailTruncation" />
	</Style>

	<!-- Tile generi: Gotham Bold 18 / -0.72 -->
	<Style x:Key="TileTitle" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratBold" />
		<Setter Property="FontSize" Value="18" />
		<Setter Property="CharacterSpacing" Value="-0.64" />
		<Setter Property="Margin" Value="9,17,9,0" />
	</Style>

	<!-- Righe brano (Playlist Screen): titolo Gotham Medium 20 / -0.8, artista 16 / -0.96 -->
	<Style x:Key="RowTitle" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratMedium" />
		<Setter Property="FontSize" Value="20" />
		<Setter Property="CharacterSpacing" Value="-0.64" />
		<Setter Property="LineBreakMode" Value="TailTruncation" />
	</Style>

	<Style x:Key="RowArtist" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratMedium" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="CharacterSpacing" Value="-0.96" />
		<Setter Property="TextColor" Value="{DynamicResource TextRow}" />
		<Setter Property="LineBreakMode" Value="TailTruncation" />
	</Style>

	<!-- Badge "LYRICS" → qui la durata: Gotham Bold 10 su #C4C4C4 -->
	<Style x:Key="BadgeText" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratBold" />
		<Setter Property="FontSize" Value="10" />
		<Setter Property="CharacterSpacing" Value="-0.96" />
		<Setter Property="TextColor" Value="{DynamicResource Background}" />
	</Style>

	<!-- Player: tempi Gotham Medium 14 / -1.12 (titolo e artista ora stanno nell'hero, vedi Controls/Hero.cs) -->
	<Style x:Key="PlayerTime" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratMedium" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="CharacterSpacing" Value="-1.28" />
		<Setter Property="TextColor" Value="{DynamicResource TextPlayer}" />
	</Style>

	<!-- Mini-player (non nel Figma): stessa famiglia, scala ridotta -->
	<Style x:Key="MiniTitle" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratBold" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="CharacterSpacing" Value="-0.64" />
		<Setter Property="LineBreakMode" Value="TailTruncation" />
	</Style>

	<Style x:Key="MiniArtist" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratMedium" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="CharacterSpacing" Value="-0.64" />
		<Setter Property="TextColor" Value="{DynamicResource TextPlayer}" />
		<Setter Property="LineBreakMode" Value="TailTruncation" />
	</Style>

	<!-- Nav Bar: Gotham Book 12 -->
	<Style x:Key="NavLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratRegular" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextColor" Value="{DynamicResource NavInactive}" />
		<Setter Property="HorizontalTextAlignment" Value="Center" />
	</Style>

	<!-- Pulsante-pillola piccolo (stato episodio): bordato, il trigger lo riempie quando è attivo -->
	<Style x:Key="Chip" TargetType="Border">
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 15" />
		<Setter Property="Padding" Value="14,7" />
	</Style>

	<Style x:Key="ChipText" TargetType="Label">
		<Setter Property="FontFamily" Value="MontserratBold" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
	</Style>

	<!-- Icone-maschera: bianche di default -->
	<Style x:Key="Icon" TargetType="Image">
		<Setter Property="Tint.Color" Value="{DynamicResource TextPrimary}" />
		<Setter Property="Aspect" Value="AspectFit" />
	</Style>

</ResourceDictionary>
